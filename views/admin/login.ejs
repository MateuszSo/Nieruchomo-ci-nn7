<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="flex-1 flex items-center justify-center py-16 px-4">
  <div class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-lg p-8">
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl bg-slate-900 text-amber-400 flex items-center justify-center mx-auto mb-4 font-serif font-bold text-2xl shadow">
        <%= (settings.brandName || 'K').substring(0, 1) %>
      </div>
      <h1 class="font-serif font-bold text-2xl text-slate-900">Panel właściciela strony</h1>
      <p class="text-sm text-slate-500 mt-1">Zaloguj się, aby dodawać i edytować nieruchomości, bloga oraz zakładki.</p>
    </div>

    <form action="/admin/login" method="POST" class="space-y-5">
      <div>
        <label for="username" class="block text-sm font-semibold text-slate-700 mb-1.5">Login administratora</label>
        <input
          type="text"
          id="username"
          name="username"
          required
          autofocus
          placeholder="np. admin"
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 focus:ring-2 focus:ring-amber-500/20 outline-none text-sm"
        >
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-slate-700 mb-1.5">Hasło</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          placeholder="••••••••"
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 focus:ring-2 focus:ring-amber-500/20 outline-none text-sm"
        >
      </div>

      <button
        type="submit"
        class="w-full py-3.5 px-6 rounded-xl bg-slate-900 hover:bg-amber-600 text-white font-semibold text-sm shadow transition"
      >
        Zaloguj się do panelu CMS
      </button>
    </form>

    <div class="mt-6 pt-5 border-t border-slate-100 text-center">
      <a href="/" class="text-xs font-medium text-slate-500 hover:text-amber-600">← Powrót do strony głównej</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
