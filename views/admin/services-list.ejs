<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Lewa kolumna: Formularz dodawania / edycji usługi -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm sticky top-24">
        <h2 class="font-serif font-bold text-xl text-slate-900 mb-1">
          <%= editingService ? `Edytuj usługę: ${editingService.title}` : 'Dodaj nową usługę' %>
        </h2>
        <p class="text-xs text-slate-500 mb-5">Karty usług wyświetlają się w zakładce „Oferta” oraz na Stronie Głównej.</p>

        <form
          action="<%= editingService ? `/admin/oferta/${editingService.id}/edytuj` : '/admin/oferta/nowa' %>"
          method="POST"
          class="space-y-4"
        >
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nazwa usługi *</label>
            <input
              type="text"
              name="title"
              required
              value="<%= editingService ? editingService.title : '' %>"
              placeholder="np. Pośrednictwo w sprzedaży"
              class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
            >
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Krótki podtytuł</label>
            <input
              type="text"
              name="subtitle"
              value="<%= editingService ? editingService.subtitle : '' %>"
              placeholder="Jednozdaniowe podsumowanie korzyści"
              class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
            >
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Ikona</label>
              <select name="icon" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-sm">
                <% const icons = [
                  { v: 'home', l: '🏠 Dom / Sprzedaż' },
                  { v: 'key', l: '🔑 Klucz / Wynajem' },
                  { v: 'search', l: '🔍 Poszukiwanie' },
                  { v: 'sparkles', l: '✨ Home Staging' },
                  { v: 'map', l: '🗺️ Działki / Grunty' },
                  { v: 'shield', l: '🛡️ Prawo / Kredyt' }
                ]; %>
                <% icons.forEach(ic => { %>
                  <option value="<%= ic.v %>" <%= (editingService && editingService.icon === ic.v) ? 'selected' : '' %>><%= ic.l %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Kolejność</label>
              <input
                type="number"
                name="order"
                value="<%= editingService ? editingService.order : services.length + 1 %>"
                class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm"
              >
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Opis usługi *</label>
            <textarea
              name="description"
              rows="3"
              required
              class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
            ><%= editingService ? editingService.description : '' %></textarea>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Zakres działań – punkty (po jednym w linii)</label>
            <textarea
              name="features"
              rows="4"
              placeholder="Weryfikacja stanu prawnego&#10;Profesjonalna sesja zdjęciowa&#10;Negocjacje cenowe"
              class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs"
            ><%= editingService && editingService.features ? editingService.features.join('\n') : '' %></textarea>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-amber-600 text-white text-sm font-semibold transition">
              <%= editingService ? 'Zapisz zmiany' : '+ Dodaj usługę' %>
            </button>
            <% if (editingService) { %>
              <a href="/admin/oferta" class="py-2.5 px-4 rounded-xl border border-slate-300 text-xs font-semibold text-slate-600">Anuluj</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Prawa kolumna: Lista usług -->
    <div class="lg:col-span-2 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-serif font-bold text-xl text-slate-900">Aktualne karty usług (<%= services.length %>)</h2>
        <a href="/oferta" target="_blank" class="text-xs font-semibold text-amber-600 hover:underline">Zobacz zakładkę Oferta →</a>
      </div>

      <% services.forEach(service => { %>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-bold">#<%= service.order %></span>
              <h3 class="font-serif font-bold text-lg text-slate-900"><%= service.title %></h3>
            </div>
            <% if (service.subtitle) { %>
              <p class="text-xs font-medium text-amber-700 mt-0.5"><%= service.subtitle %></p>
            <% } %>
            <p class="text-sm text-slate-600 mt-2"><%= service.description %></p>
            <% if (service.features && service.features.length > 0) { %>
              <ul class="mt-3 space-y-1 text-xs text-slate-500">
                <% service.features.forEach(f => { %>
                  <li>✓ <%= f %></li>
                <% }) %>
              </ul>
            <% } %>
          </div>

          <div class="flex sm:flex-col items-center gap-2 shrink-0">
            <a
              href="/admin/oferta?edytuj=<%= service.id %>"
              class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-amber-600 text-white text-xs font-semibold transition w-full text-center"
            >
              Edytuj
            </a>
            <form
              action="/admin/oferta/<%= service.id %>/usun"
              method="POST"
              onsubmit="return confirm('Usunąć tę usługę z zakładki Oferta?');"
              class="w-full"
            >
              <button type="submit" class="w-full px-3 py-1.5 rounded-lg border border-rose-200 hover:bg-rose-50 text-xs font-semibold text-rose-600">
                Usuń
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
