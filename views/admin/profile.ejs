<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
      <div class="flex items-center gap-4">
        <img
          src="<%= profileUser.avatar || '/images/demo/agent-portrait.svg' %>"
          alt="<%= profileUser.name %>"
          class="w-16 h-20 rounded-2xl object-cover border border-slate-200"
        >
        <div>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold border <%= helpers.getRoleBadge(profileUser.role).badgeClass %>">
            <%= helpers.getRoleBadge(profileUser.role).label %>
          </span>
          <h2 class="font-serif font-bold text-2xl text-slate-900 mt-1"><%= profileUser.name %></h2>
          <p class="text-xs text-slate-500">Dane z tego formularza wyświetlają się na Twojej wizytówce przy ogłoszeniach oraz wpisach na blogu.</p>
        </div>
      </div>
    </div>

    <form action="/admin/profil" method="POST" enctype="multipart/form-data" class="space-y-6 mt-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Imię i nazwisko *</label>
          <input type="text" name="name" required value="<%= profileUser.name %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Stanowisko / Tytuł zawodowy</label>
          <input type="text" name="title" value="<%= profileUser.title %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Telefon bezpośredni *</label>
          <input type="text" name="phone" required value="<%= profileUser.phone %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Adres e-mail *</label>
          <input type="email" name="email" required value="<%= profileUser.email %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Numer licencji (opcjonalnie)</label>
          <input type="text" name="licenseNumber" value="<%= profileUser.licenseNumber %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Zmień zdjęcie profilowe</label>
          <input
            type="file"
            name="avatarFile"
            accept="image/*"
            data-compress-webp="true"
            class="w-full text-xs text-slate-600 file:mr-3 file:py-2 file:px-3.5 file:rounded-xl file:border-0 file:bg-amber-50 file:text-amber-700 file:font-semibold"
          >
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Krótki biogram / opis doświadczenia</label>
        <textarea name="bio" rows="3" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm"><%= profileUser.bio %></textarea>
      </div>

      <!-- Zmiana loginu lub hasła -->
      <div class="pt-5 border-t border-slate-100">
        <h3 class="font-serif font-bold text-lg text-slate-900 mb-1">Dane logowania i zmiana hasła</h3>
        <p class="text-xs text-slate-500 mb-4">Zostaw pola hasła puste, jeśli nie chcesz go teraz zmieniać.</p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Twój login *</label>
            <input type="text" name="username" required value="<%= profileUser.username %>" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Obecne hasło (wymagane przy zmianie hasła)</label>
            <input type="password" name="currentPassword" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nowe hasło (min. 6 znaków)</label>
            <input type="password" name="newPassword" minlength="6" placeholder="Nowe hasło" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm">
          </div>
        </div>
      </div>

      <div class="flex justify-end pt-3">
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-amber-600 text-white text-sm font-semibold shadow transition">
          Zapisz mój profil
        </button>
      </div>
    </form>
  </div>
</main>

<script src="/js/admin.js"></script>
<%- include('../partials/footer') %>
