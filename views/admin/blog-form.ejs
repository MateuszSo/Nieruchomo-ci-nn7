<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h2 class="font-serif font-bold text-2xl text-slate-900">
        <%= post ? `Edycja wpisu: ${post.title}` : 'Napisz nowy artykuł na bloga' %>
      </h2>
      <p class="text-sm text-slate-500 mt-1">Skorzystaj z przycisków formatowania, aby dodać nagłówki, pogrubienia i wypunktowania.</p>
    </div>
    <a href="/admin/blog" class="text-sm font-semibold text-slate-600 hover:text-slate-900">← Wróć do listy wpisów</a>
  </div>

  <form
    action="<%= post ? `/admin/blog/${post.id}/edytuj` : '/admin/blog/nowy' %>"
    method="POST"
    enctype="multipart/form-data"
    class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6"
  >
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <div class="sm:col-span-2">
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tytuł artykułu *</label>
        <input
          type="text"
          name="title"
          required
          value="<%= post ? post.title : '' %>"
          placeholder="np. Jak przygotować mieszkanie do sprzedaży?"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm"
        >
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Kategoria</label>
        <input
          type="text"
          name="category"
          value="<%= post ? post.category : 'Poradnik nieruchomości' %>"
          placeholder="np. Poradnik sprzedającego"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm"
        >
      </div>

      <% if (currentUser && currentUser.role === 'admin' && typeof agents !== 'undefined') { %>
        <div class="sm:col-span-3">
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Autor artykułu</label>
          <select name="authorId" class="w-full sm:w-80 px-4 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-sm font-semibold">
            <% const currentAuthorId = post ? (post.authorId || 1) : currentUser.id; %>
            <% agents.forEach(ag => { %>
              <option value="<%= ag.id %>" <%= Number(currentAuthorId) === Number(ag.id) ? 'selected' : '' %>>
                <%= ag.name %> (<%= ag.title %>)
              </option>
            <% }) %>
          </select>
        </div>
      <% } %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-1.5">Krótka zajawka (widoczna na liście artykułów i w Google) *</label>
      <textarea
        name="excerpt"
        rows="2"
        required
        placeholder="2-3 zdania podsumowujące o czym jest ten artykuł..."
        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm"
      ><%= post ? post.excerpt : '' %></textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2 border-t border-slate-100">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Wgraj zdjęcie główne artykułu</label>
        <input
          type="file"
          name="coverImageFile"
          accept="image/*"
          data-compress-webp="true"
          data-generate-thumb="true"
          data-max-width="1440"
          class="w-full text-sm text-slate-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-50 file:text-amber-700"
        >
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Lub adres URL zdjęcia</label>
        <input
          type="text"
          name="coverImageUrl"
          value="<%= post ? post.coverImage : '/images/demo/blog-cover.svg' %>"
          class="w-full px-4 py-2 rounded-xl border border-slate-300 text-sm"
        >
      </div>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <label class="block text-sm font-semibold text-slate-700">Treść artykułu *</label>
        <div class="flex flex-wrap items-center gap-1 text-xs">
          <button type="button" onclick="insertHtmlTag('postContent', '<h3>', '</h3>')" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 font-semibold">Nagłówek H3</button>
          <button type="button" onclick="insertHtmlTag('postContent', '<strong>', '</strong>')" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 font-bold">Pogrubienie</button>
          <button type="button" onclick="insertHtmlTag('postContent', '<em>', '</em>')" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 italic">Kursywa</button>
          <button type="button" onclick="insertHtmlTag('postContent', '<p>', '</p>')" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200">Akapit</button>
          <button type="button" onclick="insertHtmlTag('postContent', '<ul>\n  <li>', '</li>\n</ul>')" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200">Lista punktowana</button>
        </div>
      </div>
      <textarea
        id="postContent"
        name="content"
        rows="13"
        required
        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm font-mono"
      ><%= post ? post.content : '<p>Wprowadzenie do artykułu...</p>\n<h3>1. Pierwszy krok</h3>\n<p>Rozwinięcie myśli...</p>' %></textarea>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
      <label class="inline-flex items-center gap-2.5 cursor-pointer">
        <input
          type="checkbox"
          name="published"
          <%= (!post || post.published) ? 'checked' : '' %>
          class="w-5 h-5 rounded border-slate-300 text-amber-600"
        >
        <span class="text-sm font-semibold text-slate-800">Artykuł opublikowany (widoczny publicznie)</span>
      </label>

      <div class="flex items-center gap-3">
        <a href="/admin/blog" class="px-5 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-700">Anuluj</a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-amber-600 text-white text-sm font-semibold shadow transition">
          <%= post ? 'Zapisz zmiany' : 'Opublikuj artykuł' %>
        </button>
      </div>
    </div>
  </form>
</main>

<script src="/js/admin.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '2.0' %>" defer></script>
<%- include('../partials/footer') %>
