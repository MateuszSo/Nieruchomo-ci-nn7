<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Lewa kolumna: Formularz dodawania / edycji konta agenta -->
    <div class="lg:col-span-5">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h2 class="font-serif font-bold text-xl text-slate-900 mb-1">
          <%= editingUser ? `Edycja konta: ${editingUser.name}` : 'Utwórz nowe konto agenta' %>
        </h2>
        <p class="text-xs text-slate-500 mb-5">
          Wybierz rolę <strong>Admin</strong> (pełne zarządzanie całą stroną) lub <strong>Agent</strong> (zarządzanie wyłącznie własnymi ogłoszeniami i artykułami).
        </p>

        <form
          action="<%= editingUser ? `/admin/agenci/${editingUser.id}/edytuj` : '/admin/agenci/nowy' %>"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4"
        >
          <!-- Wybór roli i statusu -->
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Uprawnienia konta (Rola) *</label>
              <select name="role" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 bg-white text-sm font-semibold">
                <option value="agent" <%= (!editingUser || editingUser.role === 'agent') ? 'selected' : '' %>>
                  👤 Agent – zarządza tylko własnymi ofertami i wpisami
                </option>
                <option value="admin" <%= (editingUser && editingUser.role === 'admin') ? 'selected' : '' %>>
                  🔑 Admin – pełny dostęp do wszystkich treści i ustawień
                </option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Status logowania</label>
              <select name="active" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 bg-white text-sm">
                <option value="true" <%= (!editingUser || editingUser.active !== false) ? 'selected' : '' %>>🟢 Konto aktywne (może się logować)</option>
                <option value="false" <%= (editingUser && editingUser.active === false) ? 'selected' : '' %>>🔴 Konto zablokowane</option>
              </select>
            </div>
          </div>

          <!-- Dane logowania -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Login do logowania *</label>
              <input
                type="text"
                name="username"
                required
                value="<%= editingUser ? editingUser.username : '' %>"
                placeholder="np. j.nowak"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
              >
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                <%= editingUser ? 'Nowe hasło (zostaw puste bez zmian)' : 'Hasło startowe *' %>
              </label>
              <input
                type="password"
                name="<%= editingUser ? 'newPassword' : 'password' %>"
                <%= editingUser ? '' : 'required minlength="6"' %>
                placeholder="<%= editingUser ? 'Bez zmian' : 'Min. 6 znaków' %>"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
              >
            </div>
          </div>

          <!-- Dane wizytówki agenta -->
          <div class="pt-3 border-t border-slate-100 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-amber-700">Wizytówka agenta (widoczna przy jego ofertach)</h3>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Imię i nazwisko *</label>
              <input
                type="text"
                name="name"
                required
                value="<%= editingUser ? editingUser.name : '' %>"
                placeholder="np. Jan Nowak"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
              >
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Stanowisko / Tytuł</label>
                <input
                  type="text"
                  name="title"
                  value="<%= editingUser ? editingUser.title : 'Doradca ds. Nieruchomości' %>"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
                >
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Nr licencji (opcjonalnie)</label>
                <input
                  type="text"
                  name="licenseNumber"
                  value="<%= editingUser ? editingUser.licenseNumber : '' %>"
                  placeholder="np. Licencja PFRN nr 32100"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
                >
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Telefon bezpośredni *</label>
                <input
                  type="text"
                  name="phone"
                  required
                  value="<%= editingUser ? editingUser.phone : '+48 ' %>"
                  placeholder="+48 600 000 000"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
                >
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Adres e-mail *</label>
                <input
                  type="email"
                  name="email"
                  required
                  value="<%= editingUser ? editingUser.email : '' %>"
                  placeholder="j.nowak@twojadomena.pl"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm"
                >
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Zdjęcie profilowe agenta</label>
              <input
                type="file"
                name="avatarFile"
                accept="image/*"
                data-compress-webp="true"
                class="w-full text-xs text-slate-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-amber-50 file:text-amber-700 file:font-semibold"
              >
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Krótki opis / specjalizacja</label>
              <textarea
                name="bio"
                rows="3"
                placeholder="Specjalizuje się w sprzedaży mieszkań i domów..."
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs"
              ><%= editingUser ? editingUser.bio : '' %></textarea>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-amber-600 text-white text-sm font-semibold transition">
              <%= editingUser ? 'Zapisz zmiany konta' : '+ Utwórz konto agenta' %>
            </button>
            <% if (editingUser) { %>
              <a href="/admin/agenci" class="py-2.5 px-4 rounded-xl border border-slate-300 text-xs font-semibold text-slate-600">Anuluj</a>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <!-- Prawa kolumna: Lista wszystkich kont w systemie -->
    <div class="lg:col-span-7 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-serif font-bold text-xl text-slate-900">Konta w systemie (<%= users.length %>)</h2>
          <p class="text-xs text-slate-500">Wszyscy administratorzy i agenci współpracujący z biurem.</p>
        </div>
        <a href="/o-mnie#zespol" target="_blank" class="text-xs font-semibold text-amber-600 hover:underline">Zobacz zespół na stronie →</a>
      </div>

      <% users.forEach(u => {
        const roleInfo = helpers.getRoleBadge(u.role);
      %>
        <div class="bg-white rounded-2xl border <%= u.active === false ? 'border-rose-200 opacity-75' : 'border-slate-200' %> p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <img
              src="<%= u.avatar || '/images/demo/agent-portrait.svg' %>"
              alt="<%= u.name %>"
              class="w-16 h-20 rounded-xl object-cover bg-slate-100 border border-slate-200 shrink-0"
            >
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-serif font-bold text-lg text-slate-900"><%= u.name %></h3>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border <%= roleInfo.badgeClass %>">
                  <%= roleInfo.label %>
                </span>
                <% if (u.active === false) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700">Zablokowane</span>
                <% } %>
              </div>

              <p class="text-xs text-slate-500 mt-0.5">
                Login: <strong class="text-slate-800"><%= u.username %></strong> · <%= u.title %>
              </p>

              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-600">
                <span>Tel: <strong><%= u.phone || '-' %></strong></span>
                <span>E-mail: <strong><%= u.email || '-' %></strong></span>
              </div>

              <div class="mt-2.5 flex items-center gap-3 text-xs">
                <a href="/admin/nieruchomosci?agent=<%= u.id %>" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-amber-50 text-slate-700 hover:text-amber-700 font-semibold">
                  Oferty agenta: <%= u.propertiesCount %>
                </a>
                <span class="text-slate-400">Wpisy na blogu: <%= u.postsCount %></span>
              </div>
            </div>
          </div>

          <div class="flex sm:flex-col items-center gap-2 shrink-0">
            <a
              href="/admin/agenci?edytuj=<%= u.id %>"
              class="w-full px-3.5 py-1.5 rounded-lg bg-slate-900 hover:bg-amber-600 text-white text-xs font-semibold text-center transition"
            >
              Edytuj konto
            </a>
            <% if (Number(u.id) !== Number(currentUser.id)) { %>
              <form
                action="/admin/agenci/<%= u.id %>/usun"
                method="POST"
                onsubmit="return confirm('Czy na pewno usunąć konto tego agenta? Wszystkie jego ogłoszenia i artykuły zostaną automatycznie przepisane na Twoje konto.');"
                class="w-full"
              >
                <button type="submit" class="w-full px-3.5 py-1.5 rounded-lg border border-rose-200 hover:bg-rose-50 text-xs font-semibold text-rose-600">
                  Usuń
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<script src="/js/admin.js"></script>
<%- include('../partials/footer') %>
