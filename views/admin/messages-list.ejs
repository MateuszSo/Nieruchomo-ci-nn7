<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <div class="mb-6">
    <h2 class="font-serif font-bold text-xl text-slate-900">Skrzynka zapytań od klientów (<%= messages.length %>)</h2>
    <p class="text-sm text-slate-500">Wszystkie wiadomości wysłane z zakładki Kontakt oraz z kart poszczególnych nieruchomości.</p>
  </div>

  <% if (messages.length === 0) { %>
    <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center text-slate-500">
      Brak wiadomości w skrzynce.
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% messages.forEach(msg => { %>
        <div class="bg-white rounded-2xl border <%= msg.read ? 'border-slate-200' : 'border-amber-400 ring-1 ring-amber-400/30' %> p-6 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
              <% if (!msg.read) { %>
                <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[11px] font-bold">Nowa</span>
              <% } %>
              <h3 class="font-bold text-base text-slate-900"><%= msg.name %></h3>
              <span class="text-xs text-slate-400">· <%= helpers.formatDate(msg.createdAt) %></span>
            </div>

            <div class="flex items-center gap-2">
              <form action="/admin/wiadomosci/<%= msg.id %>/przeczytana" method="POST" class="inline">
                <input type="hidden" name="read" value="<%= msg.read ? 'false' : 'true' %>">
                <button type="submit" class="px-3 py-1 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-medium text-slate-600">
                  <%= msg.read ? 'Oznacz jako nieprzeczytaną' : '✓ Oznacz jako przeczytaną' %>
                </button>
              </form>
              <form action="/admin/wiadomosci/<%= msg.id %>/usun" method="POST" onsubmit="return confirm('Usunąć tę wiadomość?');" class="inline">
                <button type="submit" class="px-3 py-1 rounded-lg border border-rose-200 hover:bg-rose-50 text-xs font-semibold text-rose-600">
                  Usuń
                </button>
              </form>
            </div>
          </div>

          <div class="py-3 grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs text-slate-600">
            <div><span class="text-slate-400">Telefon:</span> <a href="tel:<%= msg.phone %>" class="font-semibold text-slate-900 hover:text-amber-600"><%= msg.phone || 'Nie podano' %></a></div>
            <div><span class="text-slate-400">E-mail:</span> <a href="mailto:<%= msg.email %>" class="font-semibold text-slate-900 hover:text-amber-600"><%= msg.email || 'Nie podano' %></a></div>
            <div><span class="text-slate-400">Temat:</span> <strong class="text-slate-800"><%= msg.subject %></strong></div>
          </div>

          <% if (msg.propertyTitle) { %>
            <div class="mb-3 px-3.5 py-2 rounded-xl bg-amber-50 border border-amber-200/70 text-xs text-amber-900">
              Dotyczy oferty: <strong><%= msg.propertyTitle %></strong>
            </div>
          <% } %>

          <div class="p-4 rounded-xl bg-slate-50 text-sm text-slate-700 whitespace-pre-wrap"><%= msg.message %></div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
