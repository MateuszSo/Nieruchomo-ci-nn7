<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="font-serif font-bold text-xl text-slate-900">
        <%= currentUser.role === 'admin' ? `Wszystkie nieruchomości (${properties.length})` : `Moje nieruchomości (${properties.length})` %>
      </h2>
      <p class="text-sm text-slate-500">Dodawaj nowe ogłoszenia, zmieniaj ich status jednym kliknięciem lub edytuj szczegóły.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <% if (currentUser.role === 'admin' && typeof agents !== 'undefined') { %>
        <form action="/admin/nieruchomosci" method="GET" class="flex items-center gap-2">
          <select name="agent" onchange="this.form.submit()" class="px-3.5 py-2 rounded-xl border border-slate-300 bg-white text-xs font-semibold">
            <option value="">Wszyscy agenci</option>
            <% agents.forEach(ag => { %>
              <option value="<%= ag.id %>" <%= Number(selectedAgent) === Number(ag.id) ? 'selected' : '' %>>
                Opiekun: <%= ag.name %>
              </option>
            <% }) %>
          </select>
        </form>
      <% } %>
      <a href="/admin/nieruchomosci/nowa" class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-sm font-semibold shadow-sm transition text-center">
        + Dodaj nową nieruchomość
      </a>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500">
            <th class="py-3.5 px-4">Nieruchomość</th>
            <th class="py-3.5 px-4">Opiekun oferty</th>
            <th class="py-3.5 px-4">Kategoria / Typ</th>
            <th class="py-3.5 px-4">Cena i metraż</th>
            <th class="py-3.5 px-4">Szybka zmiana statusu</th>
            <th class="py-3.5 px-4 text-right">Akcje</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% properties.forEach(prop => {
            const propAuthor = getAuthor(prop);
          %>
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  <img src="<%= prop.images?.[0] || '/images/demo/prop-1.svg' %>" alt="" class="w-16 h-12 rounded-lg object-cover bg-slate-100 shrink-0">
                  <div>
                    <a href="/nieruchomosci/<%= prop.slug %>" target="_blank" class="font-bold text-slate-900 hover:text-amber-600 block">
                      <%= prop.title %>
                    </a>
                    <span class="text-xs text-slate-500"><%= prop.city %><%= prop.district ? ` · ${prop.district}` : '' %></span>
                    <% if (prop.featured) { %>
                      <span class="ml-1.5 inline-block px-2 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-bold">Wyróżniona na głównej</span>
                    <% } %>
                  </div>
                </div>
              </td>

              <td class="py-4 px-4">
                <div class="flex items-center gap-2">
                  <img src="<%= propAuthor.avatar || '/images/demo/agent-portrait.svg' %>" alt="" class="w-7 h-7 rounded-full object-cover border border-slate-200">
                  <span class="text-xs font-semibold text-slate-800"><%= propAuthor.name %></span>
                </div>
              </td>

              <td class="py-4 px-4">
                <span class="block font-medium text-slate-800"><%= helpers.getCategoryLabel(prop.category) %></span>
                <span class="text-xs text-slate-500"><%= helpers.getTransactionLabel(prop.transactionType) %></span>
              </td>

              <td class="py-4 px-4">
                <strong class="block text-slate-900"><%= helpers.formatPrice(prop.price) %></strong>
                <span class="text-xs text-slate-500"><%= prop.area %> m² · <%= prop.rooms %> pok.</span>
              </td>

              <td class="py-4 px-4">
                <form action="/admin/nieruchomosci/<%= prop.id %>/status" method="POST" class="inline-flex items-center gap-1.5">
                  <select
                    name="status"
                    onchange="this.form.submit()"
                    class="px-3 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold bg-white focus:border-amber-600 outline-none"
                  >
                    <option value="dostepne" <%= prop.status === 'dostepne' ? 'selected' : '' %>>🟢 Dostępne</option>
                    <option value="zarezerwowane" <%= prop.status === 'zarezerwowane' ? 'selected' : '' %>>🟡 Zarezerwowane</option>
                    <option value="sprzedane" <%= prop.status === 'sprzedane' ? 'selected' : '' %>>🔴 Sprzedane / Wynajęte</option>
                  </select>
                </form>
              </td>

              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="inline-flex items-center gap-2">
                  <a
                    href="/nieruchomosci/<%= prop.slug %>"
                    target="_blank"
                    class="px-2.5 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 text-xs font-medium text-slate-600"
                  >
                    Podgląd
                  </a>
                  <a
                    href="/admin/nieruchomosci/<%= prop.id %>/edytuj"
                    class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-amber-600 text-white text-xs font-semibold transition"
                  >
                    Edytuj
                  </a>
                  <form
                    action="/admin/nieruchomosci/<%= prop.id %>/usun"
                    method="POST"
                    onsubmit="return confirm('Czy na pewno chcesz trwale usunąć tę nieruchomość?');"
                    class="inline"
                  >
                    <button type="submit" class="px-2.5 py-1.5 rounded-lg border border-rose-200 hover:bg-rose-50 text-xs font-semibold text-rose-600">
                      Usuń
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
