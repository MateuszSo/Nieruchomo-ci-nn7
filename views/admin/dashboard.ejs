<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-nav') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
  <% if (typeof oversizedUploads !== 'undefined' && oversizedUploads.length > 0) {
    const totalOversizedMB = (oversizedUploads.reduce((sum, f) => sum + f.sizeBytes, 0) / (1024 * 1024)).toFixed(2);
  %>
    <!-- Alert optymalizacji ciężkich zdjęć dla Google PageSpeed -->
    <div class="mb-8 p-5 rounded-2xl bg-amber-50 border border-amber-300 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-amber-200/80 text-amber-900 text-[11px] font-bold uppercase tracking-wider">
          Optymalizacja Google PageSpeed
        </span>
        <h2 class="font-serif font-bold text-lg text-slate-900">
          Wykryto <%= oversizedUploads.length %> dużych zdjęć na serwerze (łącznie <%= totalOversizedMB %> MB)
        </h2>
        <p id="optimizeUploadsStatus" class="text-xs text-slate-700 leading-relaxed">
          Niektóre zdjęcia (np. <%= oversizedUploads[0].filename %> – <%= oversizedUploads[0].sizeKB %> KB) nie są w pełni skompresowane i spowalniają ładowanie strony na telefonach. Kliknij przycisk obok, aby automatycznie zmniejszyć ich wagę i wygenerować wersje mobilne bez utraty jakości.
        </p>
      </div>
      <button
        type="button"
        id="optimizeUploadsBtn"
        data-oversized-uploads="<%= JSON.stringify(oversizedUploads) %>"
        class="px-5 py-3 rounded-xl bg-slate-900 hover:bg-amber-600 text-white text-xs sm:text-sm font-bold shadow shrink-0 transition"
      >
        ⚡ Optymalizuj wszystkie zdjęcia (<%= oversizedUploads.length %>)
      </button>
    </div>
  <% } %>

  <!-- Statystyki w skrócie -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Wszystkie nieruchomości</span>
      <div class="flex items-baseline justify-between mt-2">
        <strong class="text-3xl font-bold text-slate-900"><%= stats.totalProperties %></strong>
        <span class="text-xs text-emerald-600 font-semibold"><%= stats.availableProperties %> dostępnych</span>
      </div>
      <div class="mt-3 text-xs text-slate-500">
        Rezerwacje: <%= stats.reservedProperties %> · Sprzedane: <%= stats.soldProperties %>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Wiadomości od klientów</span>
      <div class="flex items-baseline justify-between mt-2">
        <strong class="text-3xl font-bold text-slate-900"><%= stats.unreadMessages %></strong>
        <span class="text-xs font-semibold <%= stats.unreadMessages > 0 ? 'text-rose-600' : 'text-slate-400' %>">nieprzeczytanych</span>
      </div>
      <div class="mt-3 text-xs text-slate-500">
        Łącznie w skrzynce: <%= stats.totalMessages %> <a href="/admin/wiadomosci" class="text-amber-600 hover:underline font-semibold ml-1">Otwórz →</a>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Artykuły na blogu</span>
      <div class="flex items-baseline justify-between mt-2">
        <strong class="text-3xl font-bold text-slate-900"><%= stats.totalPosts %></strong>
        <a href="/admin/blog/nowy" class="text-xs font-semibold text-amber-600 hover:underline">+ Dodaj wpis</a>
      </div>
      <div class="mt-3 text-xs text-slate-500">
        Budują pozycjonowanie SEO w Google
      </div>
    </div>

    <% if (currentUser && currentUser.role === 'admin') { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Zespół i agenci</span>
        <div class="flex items-baseline justify-between mt-2">
          <strong class="text-3xl font-bold text-slate-900"><%= stats.totalAgents %></strong>
          <a href="/admin/agenci" class="text-xs font-semibold text-amber-600 hover:underline">+ Dodaj agenta →</a>
        </div>
        <div class="mt-3 text-xs text-slate-500">
          Konta z rolami Admin oraz Agent
        </div>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Moja wizytówka</span>
        <div class="flex items-baseline justify-between mt-2">
          <strong class="text-lg font-bold text-slate-900 truncate"><%= currentUser.name %></strong>
          <a href="/admin/profil" class="text-xs font-semibold text-amber-600 hover:underline">Edytuj profil →</a>
        </div>
        <div class="mt-3 text-xs text-slate-500">
          Twoje dane kontaktowe przy ofertach
        </div>
      </div>
    <% } %>
  </div>

  <!-- Szybkie akcje -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm mb-10">
    <h2 class="font-serif font-bold text-lg text-slate-900 mb-4">Szybkie zarządzanie</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/admin/nieruchomosci/nowa" class="p-4 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group">
        <span class="block font-bold text-slate-900 group-hover:text-amber-700">+ Dodaj nieruchomość</span>
        <span class="text-xs text-slate-500 mt-1 block">Wstaw nowe mieszkanie, dom, działkę lub lokal ze zdjęciami</span>
      </a>
      <a href="/admin/blog/nowy" class="p-4 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group">
        <span class="block font-bold text-slate-900 group-hover:text-amber-700">+ Napisz artykuł na bloga</span>
        <span class="text-xs text-slate-500 mt-1 block">Dodaj poradnik dla klientów w prostym edytorze tekstu</span>
      </a>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin/agenci" class="p-4 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group">
          <span class="block font-bold text-slate-900 group-hover:text-amber-700">Zespół i dane kontaktowe</span>
          <span class="text-xs text-slate-500 mt-1 block">Zdjęcia, telefony, e-maile, loginy i hasła właściciela oraz agentów</span>
        </a>
        <a href="/admin/tresci#glowna" class="p-4 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group">
          <span class="block font-bold text-slate-900 group-hover:text-amber-700">Wygląd, O mnie i Social Media</span>
          <span class="text-xs text-slate-500 mt-1 block">Logo, Strona główna, treść O mnie, godziny pracy, mapa i Social Media</span>
        </a>
      <% } else { %>
        <a href="/admin/profil" class="p-4 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group">
          <span class="block font-bold text-slate-900 group-hover:text-amber-700">Mój profil i zdjęcie</span>
          <span class="text-xs text-slate-500 mt-1 block">Zaktualizuj swój numer telefonu, zdjęcie, biogram i hasło</span>
        </a>
        <a href="/admin/wiadomosci" class="p-4 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group">
          <span class="block font-bold text-slate-900 group-hover:text-amber-700">Zapytania od klientów</span>
          <span class="text-xs text-slate-500 mt-1 block">Sprawdź wiadomości wysłane z kart Twoich nieruchomości</span>
        </a>
      <% } %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Ostatnio dodane nieruchomości -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-serif font-bold text-lg text-slate-900">Ostatnie nieruchomości</h2>
        <a href="/admin/nieruchomosci" class="text-xs font-semibold text-amber-600 hover:underline">Wszystkie (<%= stats.totalProperties %>) →</a>
      </div>
      <div class="divide-y divide-slate-100">
        <% recentProperties.forEach(prop => {
          const badge = helpers.getStatusBadge(prop.status);
        %>
          <div class="py-3.5 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= prop.images?.[0] || '/images/demo/prop-1.svg' %>" alt="" class="w-14 h-11 rounded-lg object-cover bg-slate-100 shrink-0">
              <div class="min-w-0">
                <a href="/nieruchomosci/<%= prop.slug %>" class="font-semibold text-sm text-slate-900 hover:text-amber-600 truncate block">
                  <%= prop.title %>
                </a>
                <span class="text-xs text-slate-500">
                  <%= prop.city %> · <%= helpers.formatPrice(prop.price) %>
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold <%= badge.bgClass %>"><%= badge.label %></span>
              <a href="/admin/nieruchomosci/<%= prop.id %>/edytuj" class="px-2.5 py-1 rounded-lg border border-slate-200 hover:bg-slate-100 text-xs font-semibold text-slate-700">
                Edytuj
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Ostatnie zapytania z formularzy -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-serif font-bold text-lg text-slate-900">Najnowsze wiadomości od klientów</h2>
        <a href="/admin/wiadomosci" class="text-xs font-semibold text-amber-600 hover:underline">Wszystkie (<%= stats.totalMessages %>) →</a>
      </div>
      <% if (recentMessages.length === 0) { %>
        <p class="text-sm text-slate-500 py-6 text-center">Brak wiadomości w skrzynce.</p>
      <% } else { %>
        <div class="divide-y divide-slate-100">
          <% recentMessages.forEach(msg => { %>
            <div class="py-3.5">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <% if (!msg.read) { %>
                    <span class="w-2 h-2 rounded-full bg-rose-600" title="Nieprzeczytana"></span>
                  <% } %>
                  <strong class="text-sm text-slate-900"><%= msg.name %></strong>
                  <span class="text-xs text-slate-400">· <%= msg.phone || msg.email %></span>
                </div>
                <span class="text-xs text-slate-400"><%= helpers.formatDate(msg.createdAt) %></span>
              </div>
              <p class="text-xs text-slate-600 mt-1 line-clamp-2"><%= msg.message %></p>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script src="/js/admin.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '2.0' %>" defer></script>
<%- include('../partials/footer') %>
