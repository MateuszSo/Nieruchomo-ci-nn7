<!DOCTYPE html>
<html lang="pl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    const resolvedTitle = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : (settings.seo?.siteTitle || settings.brandName);
    const resolvedDesc = typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : (settings.seo?.siteDescription || settings.heroSubtitle || '');
    const resolvedRobots = typeof robotsMeta !== 'undefined' && robotsMeta ? robotsMeta : 'index, follow, max-image-preview:large';
    const resolvedOgType = typeof ogType !== 'undefined' && ogType ? ogType : 'website';
    const resolvedCanonical = typeof canonicalUrl !== 'undefined' ? canonicalUrl : '';
    const resolvedOgImg = typeof ogImage !== 'undefined' && ogImage ? ogImage : '/images/og-nn7.png';
  %>
  <title><%= resolvedTitle %></title>
  <meta name="description" content="<%= resolvedDesc %>">
  <meta name="robots" content="<%= resolvedRobots %>">
  <% if (resolvedCanonical) { %>
    <link rel="canonical" href="<%= resolvedCanonical %>">
  <% } %>

  <!-- Favicon i ikona marki -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <meta name="theme-color" content="#223c66">

  <!-- Open Graph / Wizytówka Social Media (Facebook, Messenger, WhatsApp, LinkedIn) -->
  <meta property="og:type" content="<%= resolvedOgType %>">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:site_name" content="<%= settings.brandName %>">
  <% if (resolvedCanonical) { %>
    <meta property="og:url" content="<%= resolvedCanonical %>">
  <% } %>
  <meta property="og:title" content="<%= resolvedTitle %>">
  <meta property="og:description" content="<%= resolvedDesc %>">
  <meta property="og:image" content="<%= resolvedOgImg %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= settings.brandName %>">

  <!-- Twitter / X Large Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= resolvedTitle %>">
  <meta name="twitter:description" content="<%= resolvedDesc %>">
  <meta name="twitter:image" content="<%= resolvedOgImg %>">

  <!-- Dane strukturalne Schema.org (JSON-LD dla Google) -->
  <% if (typeof jsonLdSchemas !== 'undefined' && Array.isArray(jsonLdSchemas) && typeof seo !== 'undefined') { %>
    <% jsonLdSchemas.forEach(schemaObj => { %>
      <script type="application/ld+json"><%- seo.serializeJsonLd(schemaObj) %></script>
    <% }) %>
  <% } %>

  <!-- Czcionki Google: Plus Jakarta Sans & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS (CDN z paletą dopasowaną do identyfikacji wizualnej NN7: granat #2c4c7e i złoto #caa23e) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            serif: ['"Playfair Display"', 'Georgia', 'serif']
          },
          colors: {
            slate: {
              50: '#f5f7fb',
              100: '#ebf0f8',
              200: '#d7e1f0',
              300: '#bccce3',
              400: '#94accb',
              500: '#5b7396',
              600: '#42597a',
              700: '#344f78',
              800: '#2c4c7e',
              900: '#223c66',
              950: '#162846'
            },
            amber: {
              50: '#fbf8ef',
              100: '#f5edd6',
              200: '#ead9a6',
              300: '#dfc373',
              400: '#d5b24d',
              500: '#caa23e',
              600: '#b58c28',
              700: '#8f6d1b',
              800: '#735716',
              900: '#5e4713',
              950: '#362809'
            },
            brand: {
              dark: '#162846',
              navy: '#2c4c7e',
              gold: '#caa23e',
              goldLight: '#dfc373',
              cream: '#f5f7fb'
            }
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-amber-500 selection:text-white flex flex-col min-h-screen">
