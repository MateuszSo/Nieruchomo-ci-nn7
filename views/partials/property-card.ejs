<%
  const statusBadge = helpers.getStatusBadge(property.status);
  const cardImgUrl = (property.images && property.images[0]) ? property.images[0] : '/images/demo/prop-1.svg';
  const cardSrcSet = helpers.getResponsiveSrcSet(cardImgUrl);
  const isEager = typeof eagerLoad !== 'undefined' && eagerLoad;
%>
<article class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col group">
  <!-- Zdjęcie główne z odznakami -->
  <div class="relative aspect-[16/10] bg-slate-900 overflow-hidden">
    <a href="/nieruchomosci/<%= property.slug %>" class="block w-full h-full">
      <img
        src="<%= cardImgUrl %>"
        <% if (cardSrcSet) { %>srcset="<%= cardSrcSet %>" sizes="(max-width: 767px) 92vw, (max-width: 1023px) 46vw, 384px"<% } %>
        alt="<%= property.title %> – <%= helpers.getCategoryLabel(property.category).toLowerCase() %> (<%= helpers.getTransactionLabel(property.transactionType).toLowerCase() %>)<%= property.city ? `, ${property.city}` : '' %>"
        width="640"
        height="400"
        <% if (isEager) { %>fetchpriority="high"<% } else { %>loading="lazy" decoding="async"<% } %>
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
      >
    </a>

    <!-- Górne etykiety: Typ transakcji & Status -->
    <div class="absolute top-3 left-3 flex flex-wrap gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-900/90 text-white backdrop-blur-sm">
        <%= helpers.getTransactionLabel(property.transactionType) %>
      </span>
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/95 text-slate-800 shadow-sm">
        <%= helpers.getCategoryLabel(property.category) %>
      </span>
    </div>

    <div class="absolute top-3 right-3">
      <span class="px-3 py-1 rounded-full text-xs font-bold shadow-sm flex items-center gap-1.5 <%= statusBadge.bgClass %>">
        <span class="w-1.5 h-1.5 rounded-full <%= statusBadge.dotClass %>"></span>
        <%= statusBadge.label %>
      </span>
    </div>

    <!-- Cena na dole zdjęcia -->
    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent p-4 pt-10 flex items-end justify-between">
      <div>
        <span class="block text-xl sm:text-2xl font-bold text-white leading-none">
          <%= helpers.formatPrice(property.price, property.transactionType === 'wynajem' ? 'zł / mies.' : 'zł') %>
        </span>
        <% if (property.pricePerM2 && property.transactionType !== 'wynajem') { %>
          <span class="text-xs text-slate-200 mt-1 block">
            <%= helpers.formatPrice(property.pricePerM2, 'zł/m²') %>
          </span>
        <% } %>
      </div>
      <% if (helpers.canManage(property, currentUser)) { %>
        <a
          href="/admin/nieruchomosci/<%= property.id %>/edytuj"
          class="px-2.5 py-1 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow transition"
        >
          Edytuj
        </a>
      <% } %>
    </div>
  </div>

  <!-- Treść karty -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <div class="flex items-center gap-1.5 text-xs font-medium text-amber-700 min-w-0">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="truncate"><%= property.city %><%= property.district ? ` · ${property.district}` : '' %></span>
        </div>
        <% const cardAuthor = getAuthor(property); %>
        <span class="text-[11px] text-slate-500 shrink-0" title="Opiekun oferty">
          <%= cardAuthor.name %>
        </span>
      </div>

      <h3 class="font-serif font-bold text-lg text-slate-900 group-hover:text-amber-700 transition line-clamp-2 mb-4">
        <a href="/nieruchomosci/<%= property.slug %>"><%= property.title %></a>
      </h3>
    </div>

    <!-- Parametry techniczne -->
    <div class="pt-4 border-t border-slate-100 grid grid-cols-3 gap-2 text-xs text-slate-600">
      <div class="bg-slate-50 rounded-lg p-2 text-center">
        <span class="block text-slate-500">Powierzchnia</span>
        <strong class="text-slate-900 text-sm"><%= property.area %> m²</strong>
      </div>
      <div class="bg-slate-50 rounded-lg p-2 text-center">
        <span class="block text-slate-500">Pokoje</span>
        <strong class="text-slate-900 text-sm"><%= property.rooms > 0 ? property.rooms : '-' %></strong>
      </div>
      <div class="bg-slate-50 rounded-lg p-2 text-center">
        <span class="block text-slate-500">Piętro</span>
        <strong class="text-slate-900 text-sm truncate block"><%= property.floor || '-' %></strong>
      </div>
    </div>
  </div>
</article>
