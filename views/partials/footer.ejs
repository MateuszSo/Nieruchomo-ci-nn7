<footer class="bg-slate-900 text-slate-300 mt-auto border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Kolumna 1: O marce -->
      <div>
        <a href="/" class="inline-flex items-center gap-3 group mb-4">
          <% if (settings.logoImage) { %>
            <img
              src="<%= settings.logoImage === '/images/logo-nn7.svg' ? '/images/logo-nn7-light.svg' : settings.logoImage %>"
              alt="<%= settings.brandName || 'Logo' %>"
              class="h-11 sm:h-12 w-auto max-w-[170px] sm:max-w-[210px] object-contain shrink-0 transition group-hover:opacity-90"
            >
          <% } else { %>
            <div class="w-11 h-11 rounded-xl bg-amber-500 flex items-center justify-center text-slate-950 font-serif font-bold text-xl shadow-md group-hover:bg-amber-400 transition shrink-0">
              <%= (settings.brandName || 'N').substring(0, 1) %>
            </div>
          <% } %>
          <% if (!settings.hideNavbarText) { %>
            <div>
              <span class="block font-serif font-bold text-lg text-white tracking-tight leading-none">
                <%= settings.brandName %>
              </span>
              <% if (primaryAgent?.name) { %>
                <span class="block text-xs text-amber-400 mt-1">
                  <%= primaryAgent.name %><%= (primaryAgent.licenseNumber && primaryAgent.licenseNumber !== '-') ? ` · ${primaryAgent.licenseNumber}` : '' %>
                </span>
              <% } %>
            </div>
          <% } %>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed mb-5">
          <%= settings.heroSubtitle %>
        </p>
        <div class="flex items-center gap-3">
          <% if (settings.contact?.facebook) { %>
            <a href="<%= settings.contact.facebook %>" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-amber-600 text-slate-300 hover:text-white flex items-center justify-center transition">
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
              </svg>
            </a>
          <% } %>
          <% if (settings.contact?.instagram) { %>
            <a href="<%= settings.contact.instagram %>" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-amber-600 text-slate-300 hover:text-white flex items-center justify-center transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Kolumna 2: Nawigacja -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Zakładki</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-amber-400 transition">Strona główna</a></li>
          <li><a href="/o-mnie" class="hover:text-amber-400 transition">O mnie</a></li>
          <li><a href="/oferta" class="hover:text-amber-400 transition">Oferta i usługi</a></li>
          <li><a href="/nieruchomosci" class="hover:text-amber-400 transition">Nieruchomości</a></li>
          <li><a href="/blog" class="hover:text-amber-400 transition">Blog ekspercki</a></li>
          <li><a href="/kontakt" class="hover:text-amber-400 transition">Kontakt</a></li>
          <li><a href="/polityka-prywatnosci" class="hover:text-amber-400 transition">Polityka prywatności</a></li>
        </ul>
      </div>

      <!-- Kolumna 3: Kategorie ofert -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Oferty nieruchomości</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/nieruchomosci?typ=sprzedaz" class="hover:text-amber-400 transition">Nieruchomości na sprzedaż</a></li>
          <li><a href="/nieruchomosci?typ=wynajem" class="hover:text-amber-400 transition">Nieruchomości na wynajem</a></li>
          <li><a href="/nieruchomosci?kategoria=mieszkanie" class="hover:text-amber-400 transition">Mieszkania i apartamenty</a></li>
          <li><a href="/nieruchomosci?kategoria=dom" class="hover:text-amber-400 transition">Domy i rezydencje</a></li>
          <li><a href="/nieruchomosci?kategoria=dzialka" class="hover:text-amber-400 transition">Działki budowlane</a></li>
          <li><a href="/nieruchomosci?kategoria=lokal" class="hover:text-amber-400 transition">Lokale użytkowe</a></li>
        </ul>
      </div>

      <!-- Kolumna 4: Kontakt -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Bezpośredni kontakt</h3>
        <ul class="space-y-3 text-sm text-slate-300">
          <% if (primaryAgent?.phone) { %>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">Tel:</span>
              <a href="tel:<%= primaryAgent.phone.replace(/\s+/g, '') %>" class="hover:text-amber-400 font-semibold text-white"><%= primaryAgent.phone %></a>
            </li>
          <% } %>
          <% if (primaryAgent?.email) { %>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">E-mail:</span>
              <a href="mailto:<%= primaryAgent.email %>" class="hover:text-amber-400 break-all"><%= primaryAgent.email %></a>
            </li>
          <% } %>
          <% if (typeof teamAgents !== 'undefined' && teamAgents.length > 1) { %>
            <li>
              <a href="/kontakt" class="text-xs font-semibold text-amber-400 hover:underline">
                Wszystkie kontakty zespołu (<%= teamAgents.length %>) →
              </a>
            </li>
          <% } %>
          <% if (helpers.hasOfficeAddress(settings.contact)) { %>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">Biuro:</span>
              <span><%= helpers.formatOfficeAddress(settings.contact) %></span>
            </li>
          <% } %>
          <% if (settings.contact?.workingHours) { %>
            <li class="text-xs text-slate-400 pt-1">
              <%= settings.contact.workingHours %>
            </li>
          <% } %>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1">
        <p>© <%= new Date().getFullYear() %> <%= settings.brandName %>. Wszelkie prawa zastrzeżone.</p>
        <a href="/polityka-prywatnosci" class="hover:text-amber-400 transition underline underline-offset-2">Polityka prywatności i RODO</a>
      </div>
      <div class="flex items-center gap-4">
        <% if (currentUser) { %>
          <a href="/admin" class="text-amber-400 hover:underline font-medium">Panel zarządzania (CMS)</a>
        <% } else { %>
          <a href="/admin/login" class="hover:text-slate-200 transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span>Logowanie właściciela</span>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</footer>

<!-- Pełnoekranowa galeria zdjęć (Lightbox) -->
<div
  id="galleryLightbox"
  class="fixed inset-0 z-50 hidden bg-slate-950/95 backdrop-blur-md flex-col justify-between p-4 sm:p-6 select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Podgląd zdjęcia w pełnym rozmiarze"
>
  <!-- Górny pasek Lightboxa -->
  <div class="flex items-center justify-between text-white z-10">
    <span id="lightboxCounter" class="px-3.5 py-1.5 rounded-full bg-slate-800/90 text-xs sm:text-sm font-semibold text-slate-200">
      1 / 1
    </span>
    <button
      type="button"
      id="lightboxCloseBtn"
      aria-label="Zamknij podgląd (Esc)"
      class="w-10 h-10 rounded-full bg-slate-800/90 hover:bg-rose-600 text-white flex items-center justify-center text-lg font-bold transition"
    >
      ✕
    </button>
  </div>

  <!-- Środkowy obszar z pełnym, nieprzyciętym zdjęciem -->
  <div id="lightboxBackdrop" class="relative flex-1 flex items-center justify-center my-3 overflow-hidden">
    <button
      type="button"
      id="lightboxPrevBtn"
      aria-label="Poprzednie zdjęcie"
      class="absolute left-1 sm:left-4 z-10 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-800/80 hover:bg-amber-600 text-white flex items-center justify-center text-2xl font-bold shadow-lg transition"
    >
      ‹
    </button>

    <img
      id="lightboxImage"
      src=""
      alt="Powiększone zdjęcie"
      class="max-h-[78vh] max-w-[92vw] w-auto h-auto object-contain rounded-lg shadow-2xl transition duration-200"
    >

    <button
      type="button"
      id="lightboxNextBtn"
      aria-label="Następne zdjęcie"
      class="absolute right-1 sm:right-4 z-10 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-800/80 hover:bg-amber-600 text-white flex items-center justify-center text-2xl font-bold shadow-lg transition"
    >
      ›
    </button>
  </div>

  <!-- Dolny pasek miniatur w Lightboxie -->
  <div id="lightboxThumbs" class="flex items-center justify-center gap-2 overflow-x-auto py-1 max-w-4xl mx-auto"></div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
