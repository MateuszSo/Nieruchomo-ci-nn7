<footer class="bg-slate-900 text-slate-300 mt-auto border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Kolumna 1: O marce -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-amber-600 flex items-center justify-center text-white font-serif font-bold text-lg">
            <%= (settings.brandName || 'K').substring(0, 1) %>
          </div>
          <div>
            <span class="block font-serif font-bold text-lg text-white leading-none"><%= settings.brandName %></span>
            <span class="block text-xs text-amber-400 mt-1"><%= settings.licenseNumber %></span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-5">
          <%= settings.heroSubtitle %>
        </p>
        <div class="flex items-center gap-3">
          <% if (settings.contact?.facebook) { %>
            <a href="<%= settings.contact.facebook %>" target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-amber-600 text-slate-300 hover:text-white flex items-center justify-center transition">
              <span class="text-xs font-bold">FB</span>
            </a>
          <% } %>
          <% if (settings.contact?.instagram) { %>
            <a href="<%= settings.contact.instagram %>" target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-amber-600 text-slate-300 hover:text-white flex items-center justify-center transition">
              <span class="text-xs font-bold">IG</span>
            </a>
          <% } %>
          <% if (settings.contact?.linkedin) { %>
            <a href="<%= settings.contact.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-amber-600 text-slate-300 hover:text-white flex items-center justify-center transition">
              <span class="text-xs font-bold">IN</span>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Kolumna 2: Nawigacja -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Zakładki</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-amber-400 transition">Strona główna</a></li>
          <li><a href="/o-mnie" class="hover:text-amber-400 transition">O mnie</a></li>
          <li><a href="/oferta" class="hover:text-amber-400 transition">Oferta i usługi</a></li>
          <li><a href="/nieruchomosci" class="hover:text-amber-400 transition">Nieruchomości</a></li>
          <li><a href="/blog" class="hover:text-amber-400 transition">Blog ekspercki</a></li>
          <li><a href="/kontakt" class="hover:text-amber-400 transition">Kontakt</a></li>
        </ul>
      </div>

      <!-- Kolumna 3: Kategorie ofert -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Oferty nieruchomości</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/nieruchomosci?typ=sprzedaz" class="hover:text-amber-400 transition">Nieruchomości na sprzedaż</a></li>
          <li><a href="/nieruchomosci?typ=wynajem" class="hover:text-amber-400 transition">Nieruchomości na wynajem</a></li>
          <li><a href="/nieruchomosci?kategoria=mieszkanie" class="hover:text-amber-400 transition">Mieszkania i apartamenty</a></li>
          <li><a href="/nieruchomosci?kategoria=dom" class="hover:text-amber-400 transition">Domy i rezydencje</a></li>
          <li><a href="/nieruchomosci?kategoria=dzialka" class="hover:text-amber-400 transition">Działki budowlane</a></li>
          <li><a href="/nieruchomosci?kategoria=lokal" class="hover:text-amber-400 transition">Lokale użytkowe</a></li>
        </ul>
      </div>

      <!-- Kolumna 4: Kontakt -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Bezpośredni kontakt</h3>
        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-start gap-2.5">
            <span class="text-amber-400 font-bold">Tel:</span>
            <a href="tel:<%= (settings.contact?.phone || '').replace(/\s+/g, '') %>" class="hover:text-amber-400 font-semibold text-white"><%= settings.contact?.phone %></a>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-400 font-bold">E-mail:</span>
            <a href="mailto:<%= settings.contact?.email %>" class="hover:text-amber-400 break-all"><%= settings.contact?.email %></a>
          </li>
          <% if (helpers.hasOfficeAddress(settings.contact)) { %>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">Biuro:</span>
              <span><%= helpers.formatOfficeAddress(settings.contact) %></span>
            </li>
          <% } %>
          <% if (settings.contact?.workingHours) { %>
            <li class="text-xs text-slate-400 pt-1">
              <%= settings.contact.workingHours %>
            </li>
          <% } %>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© <%= new Date().getFullYear() %> <%= settings.brandName %> (<%= settings.agentName %>). Wszelkie prawa zastrzeżone.</p>
      <div class="flex items-center gap-4">
        <% if (currentUser) { %>
          <a href="/admin" class="text-amber-400 hover:underline font-medium">Panel zarządzania (CMS)</a>
        <% } else { %>
          <a href="/admin/login" class="hover:text-slate-200 transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span>Logowanie właściciela</span>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</footer>

<!-- Pełnoekranowa galeria zdjęć (Lightbox) -->
<div
  id="galleryLightbox"
  class="fixed inset-0 z-50 hidden bg-slate-950/95 backdrop-blur-md flex-col justify-between p-4 sm:p-6 select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Podgląd zdjęcia w pełnym rozmiarze"
>
  <!-- Górny pasek Lightboxa -->
  <div class="flex items-center justify-between text-white z-10">
    <span id="lightboxCounter" class="px-3.5 py-1.5 rounded-full bg-slate-800/90 text-xs sm:text-sm font-semibold text-slate-200">
      1 / 1
    </span>
    <button
      type="button"
      id="lightboxCloseBtn"
      aria-label="Zamknij podgląd (Esc)"
      class="w-10 h-10 rounded-full bg-slate-800/90 hover:bg-rose-600 text-white flex items-center justify-center text-lg font-bold transition"
    >
      ✕
    </button>
  </div>

  <!-- Środkowy obszar z pełnym, nieprzyciętym zdjęciem -->
  <div id="lightboxBackdrop" class="relative flex-1 flex items-center justify-center my-3 overflow-hidden">
    <button
      type="button"
      id="lightboxPrevBtn"
      aria-label="Poprzednie zdjęcie"
      class="absolute left-1 sm:left-4 z-10 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-800/80 hover:bg-amber-600 text-white flex items-center justify-center text-2xl font-bold shadow-lg transition"
    >
      ‹
    </button>

    <img
      id="lightboxImage"
      src=""
      alt="Powiększone zdjęcie"
      class="max-h-[78vh] max-w-[92vw] w-auto h-auto object-contain rounded-lg shadow-2xl transition duration-200"
    >

    <button
      type="button"
      id="lightboxNextBtn"
      aria-label="Następne zdjęcie"
      class="absolute right-1 sm:right-4 z-10 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-slate-800/80 hover:bg-amber-600 text-white flex items-center justify-center text-2xl font-bold shadow-lg transition"
    >
      ›
    </button>
  </div>

  <!-- Dolny pasek miniatur w Lightboxie -->
  <div id="lightboxThumbs" class="flex items-center justify-center gap-2 overflow-x-auto py-1 max-w-4xl mx-auto"></div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
