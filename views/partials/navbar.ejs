<% if (currentUser) { %>
  <!-- Górny pasek zalogowanego użytkownika (Admin / Agent) -->
  <div class="bg-slate-950 text-slate-200 text-xs sm:text-sm border-b border-amber-500/30 py-2 px-4 z-50">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-medium text-white"><%= currentUser.name || currentUser.username %></span>
        <span class="px-2 py-0.5 rounded text-[11px] font-bold uppercase <%= currentUser.role === 'admin' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40' : 'bg-sky-500/20 text-sky-300 border border-sky-500/40' %>">
          <%= currentUser.role === 'admin' ? 'Admin' : 'Agent' %>
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <a href="/admin" class="px-2.5 py-1 rounded bg-amber-600 hover:bg-amber-500 text-white font-medium transition">
          Panel CMS
        </a>
        <a href="/admin/nieruchomosci/nowa" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-amber-300 font-medium transition">
          + Dodaj nieruchomość
        </a>
        <a href="/admin/blog/nowy" class="hidden sm:inline-block px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-amber-300 font-medium transition">
          + Nowy artykuł
        </a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/agenci" class="hidden md:inline-block px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 transition">
            Agenci
          </a>
        <% } %>
        <a href="/admin/wiadomosci" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 transition relative">
          Wiadomości
          <% if (unreadMessagesCount > 0) { %>
            <span class="ml-1 px-1.5 py-0.5 text-[11px] font-bold bg-rose-600 text-white rounded-full"><%= unreadMessagesCount %></span>
          <% } %>
        </a>
        <form action="/admin/logout" method="POST" class="inline">
          <button type="submit" class="px-2 py-1 text-slate-400 hover:text-rose-400 transition">Wyloguj</button>
        </form>
      </div>
    </div>
  </div>
<% } %>

<!-- Nawigacja główna -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo / Marka -->
      <a href="/" class="flex items-center gap-3 group">
        <% if (settings.logoImage) { %>
          <img
            src="<%= settings.logoImage %>"
            alt="<%= settings.brandName || 'Logo' %>"
            class="h-11 sm:h-12 w-auto max-w-[170px] sm:max-w-[210px] object-contain shrink-0 transition group-hover:opacity-90"
          >
        <% } else { %>
          <div class="w-11 h-11 rounded-xl bg-slate-800 flex items-center justify-center text-amber-400 font-serif font-bold text-xl shadow-md border border-amber-500/30 group-hover:bg-amber-500 group-hover:text-slate-950 transition shrink-0">
            <%= (settings.brandName || 'N').substring(0, 1) %>
          </div>
        <% } %>
        <% if (!settings.hideNavbarText) { %>
          <div>
            <span class="block font-serif font-bold text-lg sm:text-xl text-slate-800 tracking-tight leading-none">
              <%= settings.brandName %>
            </span>
            <% if (primaryAgent?.name) { %>
              <span class="block text-xs text-slate-500 mt-1">
                <%= primaryAgent.name %><%= (primaryAgent.licenseNumber && primaryAgent.licenseNumber !== '-') ? ` · ${primaryAgent.licenseNumber}` : '' %>
              </span>
            <% } %>
          </div>
        <% } %>
      </a>

      <!-- Linki menu (Desktop) -->
      <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1.5">
        <% const navItems = [
          { href: '/', label: 'Strona główna', exact: true },
          { href: '/o-mnie', label: 'O mnie', exact: false },
          { href: '/oferta', label: 'Oferta', exact: false },
          { href: '/nieruchomosci', label: 'Nieruchomości', exact: false },
          { href: '/blog', label: 'Blog', exact: false },
          { href: '/kontakt', label: 'Kontakt', exact: false }
        ]; %>
        <% navItems.forEach(item => {
          const isActive = item.exact ? currentPath === item.href : currentPath.startsWith(item.href);
        %>
          <a
            href="<%= item.href %>"
            class="px-2.5 xl:px-3.5 py-2 rounded-lg text-sm font-semibold whitespace-nowrap transition <%= isActive ? 'bg-amber-50 text-amber-700' : 'text-slate-700 hover:text-amber-600 hover:bg-slate-100/70' %>"
          >
            <%= item.label %>
          </a>
        <% }) %>
      </nav>

      <!-- Social Media + Telefon + Przycisk CTA (Desktop) -->
      <div class="hidden lg:flex items-center gap-2.5 xl:gap-3">
        <% if (settings.contact?.facebook || settings.contact?.instagram) { %>
          <div class="flex items-center gap-1.5 pr-2 border-r border-slate-200">
            <% if (settings.contact?.facebook) { %>
              <a
                href="<%= settings.contact.facebook %>"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
                title="Facebook"
                class="w-9 h-9 rounded-lg bg-slate-100 hover:bg-amber-600 text-slate-700 hover:text-white flex items-center justify-center transition"
              >
                <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              </a>
            <% } %>
            <% if (settings.contact?.instagram) { %>
              <a
                href="<%= settings.contact.instagram %>"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
                title="Instagram"
                class="w-9 h-9 rounded-lg bg-slate-100 hover:bg-amber-600 text-slate-700 hover:text-white flex items-center justify-center transition"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            <% } %>
          </div>
        <% } %>
        <% if (primaryAgent?.phone) { %>
          <a href="tel:<%= primaryAgent.phone.replace(/\s+/g, '') %>" class="hidden xl:flex text-sm font-semibold text-slate-700 hover:text-amber-600 items-center gap-1.5 whitespace-nowrap">
            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span><%= primaryAgent.phone %></span>
          </a>
        <% } %>
        <a href="/kontakt" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-amber-600 text-white text-sm font-semibold shadow-sm whitespace-nowrap transition">
          Umów konsultację
        </a>
      </div>

      <!-- Social Media + Przycisk menu mobilnego -->
      <div class="flex lg:hidden items-center gap-1.5">
        <% if (settings.contact?.facebook) { %>
          <a
            href="<%= settings.contact.facebook %>"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="hidden sm:flex w-9 h-9 rounded-lg bg-slate-100 hover:bg-amber-600 text-slate-700 hover:text-white items-center justify-center transition"
          >
            <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
        <% } %>
        <% if (settings.contact?.instagram) { %>
          <a
            href="<%= settings.contact.instagram %>"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="hidden sm:flex w-9 h-9 rounded-lg bg-slate-100 hover:bg-amber-600 text-slate-700 hover:text-white items-center justify-center transition"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        <% } %>
        <button id="mobileMenuBtn" type="button" aria-label="Otwórz menu" class="p-2.5 rounded-lg text-slate-700 hover:bg-slate-100">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobilne -->
  <div id="mobileMenu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 space-y-1.5">
    <% navItems.forEach(item => {
      const isActive = item.exact ? currentPath === item.href : currentPath.startsWith(item.href);
    %>
      <a
        href="<%= item.href %>"
        class="block px-4 py-2.5 rounded-lg text-base font-semibold <%= isActive ? 'bg-amber-50 text-amber-700' : 'text-slate-700 hover:bg-slate-100' %>"
      >
        <%= item.label %>
      </a>
    <% }) %>
    <div class="pt-3 mt-2 border-t border-slate-100 flex flex-col gap-2">
      <% if (primaryAgent?.phone) { %>
        <a href="tel:<%= primaryAgent.phone.replace(/\s+/g, '') %>" class="w-full py-2.5 text-center rounded-lg border border-slate-300 text-slate-800 font-semibold">
          Zadzwoń: <%= primaryAgent.phone %>
        </a>
      <% } %>
      <a href="/kontakt" class="w-full py-2.5 text-center rounded-lg bg-amber-600 text-white font-semibold">
        Umów bezpłatną konsultację
      </a>
      <% if (settings.contact?.facebook || settings.contact?.instagram) { %>
        <div class="flex items-center justify-center gap-3 pt-2">
          <% if (settings.contact?.facebook) { %>
            <a
              href="<%= settings.contact.facebook %>"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
              class="w-10 h-10 rounded-lg bg-slate-100 hover:bg-amber-600 text-slate-700 hover:text-white flex items-center justify-center transition"
            >
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
              </svg>
            </a>
          <% } %>
          <% if (settings.contact?.instagram) { %>
            <a
              href="<%= settings.contact.instagram %>"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
              class="w-10 h-10 rounded-lg bg-slate-100 hover:bg-amber-600 text-slate-700 hover:text-white flex items-center justify-center transition"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</header>

<!-- Komunikaty powiadomień (Flash) -->
<% if (flash && flash.message) { %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="p-4 rounded-xl border flex items-center justify-between gap-4 shadow-sm <%= flash.type === 'error' ? 'bg-rose-50 border-rose-200 text-rose-800' : 'bg-emerald-50 border-emerald-200 text-emerald-800' %>">
      <div class="flex items-center gap-3 text-sm font-medium">
        <% if (flash.type === 'error') { %>
          <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        <% } else { %>
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        <% } %>
        <span><%= flash.message %></span>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="text-xs font-semibold opacity-70 hover:opacity-100">Zamknij</button>
    </div>
  </div>
<% } %>
