<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="flex-1">
  <!-- Nagłówek -->
  <section class="bg-slate-900 text-white py-14 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Blog ekspercki</span>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl text-white mt-1">Poradniki i wiedza o nieruchomościach</h1>
        <p class="text-sm text-slate-300 mt-1 max-w-2xl">
          Praktyczne wskazówki o tym, jak bezpiecznie i zyskiem sprzedać, kupić lub wynająć nieruchomość.
        </p>
      </div>
      <% if (currentUser) { %>
        <a href="/admin/blog/nowy" class="px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs sm:text-sm font-bold transition self-start sm:self-auto">
          + Napisz nowy artykuł
        </a>
      <% } %>
    </div>
  </section>

  <!-- Lista wpisów -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (posts.length === 0) { %>
      <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center text-slate-500">
        Wkrótce pojawią się tutaj nowe artykuły.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% posts.forEach(post => { %>
          <article class="bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl transition flex flex-col group">
            <a href="/blog/<%= post.slug %>" class="aspect-[16/10] bg-slate-900 block overflow-hidden relative">
              <img
                src="<%= post.coverImage || '/images/demo/blog-cover.svg' %>"
                alt="<%= post.title %>"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              >
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-900/90 text-amber-300 text-xs font-bold">
                <%= post.category %>
              </span>
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-xs text-slate-400 mb-2.5">
                  <span><%= helpers.formatDate(post.createdAt) %></span>
                  <span>·</span>
                  <span><%= helpers.readingTime(post.content) %></span>
                </div>
                <h2 class="font-serif font-bold text-xl text-slate-900 group-hover:text-amber-600 transition mb-3">
                  <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3"><%= post.excerpt %></p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                <% const postAuthor = getAuthor(post); %>
                <div class="flex items-center gap-2">
                  <img src="<%= postAuthor.avatar || '/images/demo/agent-portrait.svg' %>" alt="" class="w-6 h-6 rounded-full object-cover">
                  <span class="text-xs font-medium text-slate-600"><%= postAuthor.name %></span>
                </div>
                <div class="flex items-center gap-3">
                  <% if (helpers.canManage(post, currentUser)) { %>
                    <a href="/admin/blog/<%= post.id %>/edytuj" class="text-xs font-semibold text-amber-600 hover:underline">Edytuj</a>
                  <% } %>
                  <a href="/blog/<%= post.slug %>" class="text-xs font-bold uppercase tracking-wider text-slate-900 group-hover:text-amber-600">
                    Czytaj →
                  </a>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
