<%
  const postCoverUrl = post.coverImage || '/images/demo/blog-cover.svg';
  const postCoverSrcSet = helpers.getResponsiveSrcSet(postCoverUrl);
%>
<%- include('../partials/head', {
  preloadImage: postCoverUrl,
  preloadImageSrcSet: postCoverSrcSet,
  preloadImageSizes: '(max-width: 1023px) 94vw, 66vw'
}) %>
<%- include('../partials/navbar') %>

<main class="flex-1 py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
  <div class="flex items-center justify-between gap-4 mb-6 text-xs text-slate-500">
    <nav aria-label="Ścieżka nawigacji" class="flex items-center gap-2">
      <a href="/" class="hover:text-amber-700">Strona główna</a>
      <span aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-amber-700">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-800 font-semibold truncate max-w-xs"><%= post.title %></span>
    </nav>
    <% if (helpers.canManage(post, currentUser)) { %>
      <a href="/admin/blog/<%= post.id %>/edytuj" class="px-3.5 py-1.5 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs">
        ✎ Edytuj ten artykuł
      </a>
    <% } %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <!-- Treść artykułu -->
    <article class="lg:col-span-8 bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="aspect-[16/9] bg-slate-900 relative group overflow-hidden">
        <img
          src="<%= postCoverUrl %>"
          <% if (postCoverSrcSet) { %>srcset="<%= postCoverSrcSet %>" sizes="(max-width: 1023px) 94vw, 66vw"<% } %>
          alt="<%= post.title %>"
          width="1280"
          height="720"
          fetchpriority="high"
          data-single-lightbox="<%= postCoverUrl %>"
          class="w-full h-full object-cover cursor-zoom-in"
        >
      </div>

      <div class="p-6 sm:p-10">
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-3">
          <span class="px-3 py-1 rounded-full bg-amber-50 text-amber-700 font-bold"><%= post.category %></span>
          <span><%= helpers.formatDate(post.createdAt) %></span>
          <span aria-hidden="true">·</span>
          <span><%= helpers.readingTime(post.content) %></span>
        </div>

        <h1 class="font-serif font-bold text-2xl sm:text-4xl text-slate-900 leading-tight mb-4">
          <%= post.title %>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed pb-6 mb-6 border-b border-slate-100">
          <%= post.excerpt %>
        </p>

        <div class="rich-content text-base">
          <%- post.content %>
        </div>

        <!-- Wizytówka autora pod artykułem -->
        <% const postAuthor = getAuthor(post); %>
        <div class="mt-10 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6 bg-slate-50 rounded-2xl p-6">
          <div class="flex items-center gap-4">
            <img
              src="<%= postAuthor.avatar || '/images/demo/agent-portrait.svg' %>"
              alt="<%= postAuthor.name %>"
              width="64"
              height="80"
              loading="lazy"
              decoding="async"
              class="w-16 h-20 rounded-xl object-cover shrink-0"
            >
            <div>
              <span class="text-xs font-bold uppercase text-amber-700">Autor artykułu</span>
              <h3 class="font-serif font-bold text-lg text-slate-900"><%= postAuthor.name %></h3>
              <p class="text-xs text-slate-600"><%= postAuthor.title %></p>
              <% if (postAuthor.phone) { %>
                <span class="text-xs font-semibold text-slate-800 block mt-1">Tel: <%= postAuthor.phone %></span>
              <% } %>
            </div>
          </div>
          <a href="/nieruchomosci?agent=<%= postAuthor.id %>" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-amber-600 text-white text-xs sm:text-sm font-semibold transition shrink-0">
            Zobacz oferty autora →
          </a>
        </div>
      </div>
    </article>

    <!-- Pasek boczny -->
    <aside class="lg:col-span-4 space-y-6">
      <% if (otherPosts && otherPosts.length > 0) { %>
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
          <h2 class="font-serif font-bold text-lg text-slate-900 mb-4">Pozostałe artykuły</h2>
          <div class="space-y-4">
            <% otherPosts.forEach(op => { %>
              <a href="/blog/<%= op.slug %>" class="block group">
                <span class="text-xs text-amber-700 font-semibold"><%= op.category %></span>
                <h3 class="font-bold text-sm text-slate-900 group-hover:text-amber-700 transition mt-0.5"><%= op.title %></h3>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (featuredProperties && featuredProperties.length > 0) { %>
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
          <h2 class="font-serif font-bold text-lg text-slate-900 mb-4">Aktualne oferty nieruchomości</h2>
          <div class="space-y-4">
            <% featuredProperties.forEach(fp => { %>
              <a href="/nieruchomosci/<%= fp.slug %>" class="flex items-center gap-3 group">
                <img
                  src="<%= helpers.getSmallImage(fp.images?.[0] || '/images/demo/prop-1.svg') %>"
                  alt=""
                  width="80"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="w-20 h-14 rounded-xl object-cover shrink-0"
                >
                <div class="min-w-0">
                  <h3 class="font-bold text-xs text-slate-900 group-hover:text-amber-700 truncate"><%= fp.title %></h3>
                  <span class="text-xs font-bold text-amber-700 block mt-0.5"><%= helpers.formatPrice(fp.price) %></span>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
