<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="flex-1">
  <!-- Nagłówek zakładki -->
  <section class="bg-slate-900 text-white py-14 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400">O mnie</span>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl text-white mt-1"><%= primaryAgent.name %></h1>
        <p class="text-sm text-slate-300 mt-1">
          <%= primaryAgent.title %><%= (primaryAgent.licenseNumber && primaryAgent.licenseNumber !== '-') ? ` · ${primaryAgent.licenseNumber}` : '' %>
        </p>
      </div>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <div class="flex items-center gap-2 self-start sm:self-auto">
          <a href="/admin/agenci" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-bold transition">
            ✎ Zespół i wizytówki
          </a>
          <a href="/admin/tresci#o-mnie" class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold transition">
            ✎ Edytuj treść zakładki
          </a>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Główna sekcja biograficzna -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5">
        <div class="bg-white rounded-3xl border border-slate-200 p-5 shadow-md">
          <img
            src="<%= primaryAgent.avatar || '/images/demo/agent-portrait.svg' %>"
            alt="<%= primaryAgent.name %>"
            class="w-full rounded-2xl object-cover aspect-[4/5]"
          >
          <div class="mt-5 p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2 text-sm">
            <div class="font-serif font-bold text-lg text-slate-900"><%= primaryAgent.name %></div>
            <div class="text-xs text-slate-500"><%= primaryAgent.title %></div>
            <% if (primaryAgent.licenseNumber && primaryAgent.licenseNumber !== '-') { %>
              <div class="text-xs text-amber-700 font-semibold"><%= primaryAgent.licenseNumber %></div>
            <% } %>
            <div class="pt-2 border-t border-slate-200/80 text-xs text-slate-600 space-y-1">
              <% if (primaryAgent.phone) { %>
                <div>Tel: <a href="tel:<%= primaryAgent.phone.replace(/\s+/g, '') %>" class="font-bold text-slate-900"><%= primaryAgent.phone %></a></div>
              <% } %>
              <% if (primaryAgent.email) { %>
                <div>E-mail: <a href="mailto:<%= primaryAgent.email %>" class="font-semibold text-amber-700"><%= primaryAgent.email %></a></div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <h2 class="font-serif font-bold text-2xl sm:text-3xl text-slate-900 leading-snug">
          <%= settings.about?.title %>
        </h2>
        <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed">
          <%= settings.about?.subtitle %>
        </p>

        <div class="rich-content text-base text-slate-600">
          <%- settings.about?.bioHtml %>
        </div>
      </div>
    </div>
  </section>

  <!-- Filary współpracy -->
  <% if (settings.about?.values && settings.about.values.length > 0) { %>
    <section class="py-16 bg-white border-y border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Standard obsługi</span>
          <h2 class="font-serif font-bold text-3xl text-slate-900 mt-1">Dlaczego klienci powierzają mi swoje nieruchomości?</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
          <% settings.about.values.forEach((val, idx) => { %>
            <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/80 flex gap-4">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 font-serif font-bold flex items-center justify-center shrink-0">
                0<%= idx + 1 %>
              </div>
              <div>
                <h3 class="font-serif font-bold text-lg text-slate-900 mb-1.5"><%= val.title %></h3>
                <p class="text-sm text-slate-600 leading-relaxed"><%= val.description %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Zespół agentów (widoczny gdy w biurze działa więcej niż 1 aktywny doradca) -->
  <% if (typeof teamAgents !== 'undefined' && teamAgents.length > 1) { %>
    <section id="zespol" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Poznaj nasz zespół</span>
        <h2 class="font-serif font-bold text-3xl text-slate-900 mt-1">Doradcy ds. nieruchomości</h2>
        <p class="text-sm text-slate-500 mt-2">Każdy członek naszego zespołu dba o najwyższy standard obsługi i bezpieczeństwo transakcji.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% teamAgents.forEach(agent => { %>
          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-sm flex flex-col sm:flex-row gap-6 items-start">
            <img
              src="<%= agent.avatar || '/images/demo/agent-portrait.svg' %>"
              alt="<%= agent.name %>"
              class="w-28 h-36 rounded-2xl object-cover border border-slate-200 shrink-0"
            >
            <div class="flex-1">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700"><%= agent.title %></span>
              <h3 class="font-serif font-bold text-2xl text-slate-900 mt-0.5"><%= agent.name %></h3>
              <% if (agent.licenseNumber) { %>
                <span class="text-xs text-slate-400 block"><%= agent.licenseNumber %></span>
              <% } %>
              <% if (agent.bio) { %>
                <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed"><%= agent.bio %></p>
              <% } %>
              <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="space-y-0.5">
                  <% if (agent.phone) { %>
                    <div>Tel: <a href="tel:<%= agent.phone.replace(/\s+/g, '') %>" class="font-bold text-slate-900 hover:text-amber-600"><%= agent.phone %></a></div>
                  <% } %>
                  <% if (agent.email) { %>
                    <div>E-mail: <a href="mailto:<%= agent.email %>" class="text-amber-700 hover:underline"><%= agent.email %></a></div>
                  <% } %>
                </div>
                <a
                  href="/nieruchomosci?agent=<%= agent.id %>"
                  class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-amber-600 text-white font-semibold transition"
                >
                  Oferty agenta (<%= agent.propertiesCount %>) →
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/footer') %>
