<%
  const badge = helpers.getStatusBadge(property.status);
  const galleryImages = (property.images && property.images.length > 0) ? property.images : ['/images/demo/prop-1.svg'];
  const mainImgSrcSet = helpers.getResponsiveSrcSet(galleryImages[0]);
%>
<%- include('../partials/head', {
  preloadImage: galleryImages[0],
  preloadImageSrcSet: mainImgSrcSet,
  preloadImageSizes: '(max-width: 1023px) 94vw, 66vw'
}) %>
<%- include('../partials/navbar') %>

<main class="flex-1 py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
  <!-- Breadcrumbs i przycisk edycji właściciela -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 text-xs text-slate-500">
    <nav aria-label="Ścieżka nawigacji" class="flex items-center gap-2">
      <a href="/" class="py-1 hover:text-amber-700">Strona główna</a>
      <span aria-hidden="true">/</span>
      <a href="/nieruchomosci" class="py-1 hover:text-amber-700">Nieruchomości</a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-800 font-semibold truncate max-w-xs"><%= property.title %></span>
    </nav>
    <% if (helpers.canManage(property, currentUser)) { %>
      <a href="/admin/nieruchomosci/<%= property.id %>/edytuj" class="px-3.5 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow">
        ✎ Edytuj tę nieruchomość
      </a>
    <% } %>
  </div>

  <!-- Nagłówek nieruchomości -->
  <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm mb-8">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-slate-900 text-white">
            <%= helpers.getTransactionLabel(property.transactionType) %>
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase bg-slate-100 text-slate-800">
            <%= helpers.getCategoryLabel(property.category) %>
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-bold <%= badge.bgClass %>">
            <%= badge.label %>
          </span>
        </div>

        <h1 class="font-serif font-bold text-2xl sm:text-4xl text-slate-900 leading-tight">
          <%= property.title %>
        </h1>

        <p class="text-sm text-slate-600 mt-2 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span><%= property.city %><%= property.district ? ` · ${property.district}` : '' %><%= property.address ? ` (${property.address})` : '' %></span>
        </p>
      </div>

      <div class="lg:text-right border-t lg:border-t-0 pt-4 lg:pt-0 border-slate-100 shrink-0">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Cena ofertowa</span>
        <strong class="font-serif font-bold text-3xl sm:text-4xl text-slate-900 block mt-0.5">
          <%= helpers.formatPrice(property.price, property.transactionType === 'wynajem' ? 'zł / mies.' : 'zł') %>
        </strong>
        <% if (property.pricePerM2 && property.transactionType !== 'wynajem') { %>
          <span class="text-xs font-medium text-slate-600 mt-1 block">
            <%= helpers.formatPrice(property.pricePerM2, 'zł / m²') %>
          </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Główna siatka: Galeria + Opis (lewa) oraz Kontakt z agentem (prawa) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-8 space-y-8">
      <!-- Galeria zdjęć z pełnoekranowym podglądem (Lightbox) -->
      <div
        class="bg-white rounded-3xl border border-slate-200 p-4 sm:p-5 shadow-sm"
        data-gallery-images="<%= JSON.stringify(galleryImages) %>"
      >
        <div class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-950 group">
          <img
            id="mainPropertyImage"
            src="<%= galleryImages[0] %>"
            <% if (mainImgSrcSet) { %>srcset="<%= mainImgSrcSet %>" sizes="(max-width: 1023px) 94vw, 66vw"<% } %>
            alt="<%= property.title %><%= property.city ? ` – ${property.city}` : '' %>"
            width="1280"
            height="800"
            fetchpriority="high"
            data-open-lightbox="0"
            class="w-full h-full object-cover cursor-zoom-in transition duration-300 group-hover:scale-[1.01]"
          >

          <% if (galleryImages.length > 1) { %>
            <!-- Strzałki poprzednie / następne na głównym zdjęciu -->
            <button
              type="button"
              id="galleryPrevInline"
              aria-label="Poprzednie zdjęcie"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/75 hover:bg-slate-900 text-white flex items-center justify-center shadow-lg transition opacity-0 group-hover:opacity-100 focus:opacity-100"
            >
              ‹
            </button>
            <button
              type="button"
              id="galleryNextInline"
              aria-label="Następne zdjęcie"
              class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/75 hover:bg-slate-900 text-white flex items-center justify-center shadow-lg transition opacity-0 group-hover:opacity-100 focus:opacity-100"
            >
              ›
            </button>
          <% } %>

          <!-- Przycisk otwierający pełny rozmiar (Lightbox) -->
          <button
            type="button"
            id="openLightboxBtn"
            class="absolute bottom-3 right-3 px-3.5 py-2 rounded-xl bg-slate-900/85 hover:bg-amber-600 text-white text-xs font-semibold backdrop-blur-sm shadow-lg flex items-center gap-2 transition"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
            <span>Pełny rozmiar (<span id="inlineGalleryCounter">1 / <%= galleryImages.length %></span>)</span>
          </button>
        </div>

        <% if (galleryImages.length > 1) { %>
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-3 mt-3">
            <% galleryImages.forEach((imgUrl, idx) => { %>
              <button
                type="button"
                data-gallery-thumb="<%= imgUrl %>"
                data-gallery-index="<%= idx %>"
                aria-label="Pokaż zdjęcie <%= idx + 1 %> z <%= galleryImages.length %>"
                class="aspect-[16/10] rounded-xl overflow-hidden bg-slate-100 border border-slate-200 focus:outline-none hover:opacity-90 transition <%= idx === 0 ? 'ring-2 ring-amber-500' : '' %>"
              >
                <img
                  src="<%= helpers.getSmallImage(imgUrl) %>"
                  alt="<%= property.title %><%= property.city ? ` – ${property.city}` : '' %> (zdjęcie <%= idx + 1 %>)"
                  width="200"
                  height="125"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                >
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Tabela kluczowych parametrów -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <h2 class="font-serif font-bold text-xl text-slate-900 mb-5">Specyfikacja nieruchomości</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <span class="text-xs text-slate-500 block">Powierzchnia</span>
            <strong class="text-lg font-bold text-slate-900"><%= property.area %> m²</strong>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <span class="text-xs text-slate-500 block">Liczba pokoi</span>
            <strong class="text-lg font-bold text-slate-900"><%= property.rooms > 0 ? property.rooms : '-' %></strong>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <span class="text-xs text-slate-500 block">Piętro</span>
            <strong class="text-lg font-bold text-slate-900"><%= property.floor || '-' %></strong>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <span class="text-xs text-slate-500 block">Rok budowy</span>
            <strong class="text-lg font-bold text-slate-900"><%= property.buildYear || '-' %></strong>
          </div>
        </div>

        <!-- Atuty i udogodnienia -->
        <% if (property.amenities && property.amenities.length > 0) { %>
          <div class="mt-6 pt-6 border-t border-slate-100">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Udogodnienia i atuty oferty</h3>
            <div class="flex flex-wrap gap-2">
              <% property.amenities.forEach(item => { %>
                <span class="px-3.5 py-1.5 rounded-xl bg-amber-50 border border-amber-200/60 text-amber-900 text-xs font-semibold">
                  ✓ <%= item %>
                </span>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Pełny opis oferty -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <h2 class="font-serif font-bold text-2xl text-slate-900 mb-4">Opis nieruchomości</h2>
        <div class="rich-content text-sm sm:text-base">
          <%- property.description %>
        </div>
      </div>
    </div>

    <!-- Prawa kolumna: Formularz kontaktowy do opiekuna tej nieruchomości -->
    <% const propAuthor = getAuthor(property); %>
    <aside class="lg:col-span-4 space-y-6 sticky top-24">
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-md">
        <div class="flex items-center gap-3.5 pb-5 border-b border-slate-100">
          <img
            src="<%= propAuthor.avatar || '/images/demo/agent-portrait.svg' %>"
            alt="<%= propAuthor.name %>"
            width="64"
            height="80"
            loading="lazy"
            decoding="async"
            class="w-16 h-20 rounded-2xl object-cover border border-amber-500/40 shrink-0"
          >
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Opiekun oferty</span>
            <h3 class="font-serif font-bold text-lg text-slate-900"><%= propAuthor.name %></h3>
            <p class="text-xs text-slate-500"><%= propAuthor.title %></p>
            <% if (propAuthor.phone) { %>
              <a href="tel:<%= propAuthor.phone.replace(/\s+/g, '') %>" class="text-sm font-bold text-slate-900 hover:text-amber-700 inline-block py-1 mt-0.5">
                <%= propAuthor.phone %>
              </a>
            <% } %>
            <% if (propAuthor.email) { %>
              <a href="mailto:<%= propAuthor.email %>" class="text-xs text-amber-700 hover:underline block py-1">
                <%= propAuthor.email %>
              </a>
            <% } %>
          </div>
        </div>

        <h4 class="font-serif font-bold text-lg text-slate-900 mt-5 mb-1">Zapytaj o tę nieruchomość</h4>
        <p class="text-xs text-slate-600 mb-4">Wiadomość trafi bezpośrednio do opiekuna oferty (<%= propAuthor.name %>).</p>

        <form action="/kontakt" method="POST" class="space-y-3.5">
          <input type="hidden" name="agentId" value="<%= propAuthor.id %>">
          <input type="hidden" name="propertyId" value="<%= property.id %>">
          <input type="hidden" name="propertyTitle" value="<%= property.title %> (<%= property.city %>)">
          <input type="hidden" name="subject" value="Zapytanie o nieruchomość: <%= property.title %>">
          <input type="hidden" name="redirectUrl" value="/nieruchomosci/<%= property.slug %>">

          <div>
            <label for="prop-inquiry-name" class="sr-only">Twoje imię i nazwisko</label>
            <input
              id="prop-inquiry-name"
              type="text"
              name="name"
              required
              placeholder="Twoje imię i nazwisko *"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm"
            >
          </div>
          <div>
            <label for="prop-inquiry-phone" class="sr-only">Numer telefonu</label>
            <input
              id="prop-inquiry-phone"
              type="tel"
              name="phone"
              required
              placeholder="Numer telefonu *"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm"
            >
          </div>
          <div>
            <label for="prop-inquiry-email" class="sr-only">Adres e-mail (opcjonalnie)</label>
            <input
              id="prop-inquiry-email"
              type="email"
              name="email"
              placeholder="Adres e-mail (opcjonalnie)"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm"
            >
          </div>
          <div>
            <label for="prop-inquiry-message" class="sr-only">Treść wiadomości</label>
            <textarea
              id="prop-inquiry-message"
              name="message"
              rows="3"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm"
            >Dzień dobry, interesuje mnie oferta „<%= property.title %>”. Proszę o kontakt w sprawie prezentacji.</textarea>
          </div>

          <label class="flex items-start gap-2 text-[11px] text-slate-600 leading-relaxed cursor-pointer">
            <input
              type="checkbox"
              name="privacyAccepted"
              value="1"
              required
              class="mt-0.5 w-3.5 h-3.5 rounded border-slate-300 text-amber-600 focus:ring-amber-500 shrink-0"
            >
            <span>
              Akceptuję <a href="/polityka-prywatnosci" target="_blank" class="font-semibold text-amber-700 hover:underline">Politykę Prywatności</a> i proszę o kontakt w sprawie oferty. *
            </span>
          </label>

          <button type="submit" class="w-full py-3 px-5 rounded-xl bg-slate-900 hover:bg-amber-600 text-white font-semibold text-sm shadow transition">
            Wyślij zapytanie o ofertę
          </button>
        </form>
      </div>
    </aside>
  </div>

  <!-- Podobne oferty -->
  <% if (similarProperties && similarProperties.length > 0) { %>
    <section class="mt-16 pt-12 border-t border-slate-200">
      <h2 class="font-serif font-bold text-2xl text-slate-900 mb-6">Zobacz również inne nieruchomości</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
        <% similarProperties.forEach(prop => { %>
          <%- include('../partials/property-card', { property: prop }) %>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<% // Upewnij się, że w JS zmiana slajdu w galerii nie jest blokowana przez stary srcset pierwszego zdjęcia %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var mainImg = document.getElementById('mainPropertyImage');
    if (mainImg) {
      var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
          if (m.attributeName === 'src' && mainImg.hasAttribute('srcset')) {
            mainImg.removeAttribute('srcset');
          }
        });
      });
      observer.observe(mainImg, { attributes: true, attributeFilter: ['src'] });
    }
  });
</script>

<%- include('../partials/footer') %>
