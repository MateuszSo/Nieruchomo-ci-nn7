<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="flex-1">
  <!-- Nagłówek -->
  <section class="bg-slate-900 text-white py-14 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Kontakt</span>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl text-white mt-1">Porozmawiajmy o Twojej nieruchomości</h1>
        <p class="text-sm text-slate-300 mt-1">Zadzwoń, napisz lub zostaw wiadomość w formularzu – odpowiadamy tego samego dnia.</p>
      </div>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto">
          <a href="/admin/agenci" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition">
            ✎ Dane i telefony agentów
          </a>
          <a href="/admin/tresci#kontakt" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs font-bold transition">
            ✎ Godziny i mapa
          </a>
        </div>
      <% } %>
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Lewa kolumna: Wizytówki aktywnych agentów oraz informacje o biurze -->
      <div class="lg:col-span-5 space-y-6">
        <% const contactAgents = (typeof teamAgents !== 'undefined' && teamAgents.length > 0) ? teamAgents : [primaryAgent]; %>
        <% contactAgents.forEach(agent => { %>
          <div class="bg-white rounded-3xl border border-slate-200 p-7 shadow-sm space-y-5">
            <div class="flex items-center gap-4 pb-5 border-b border-slate-100">
              <img
                src="<%= agent.avatar || '/images/demo/agent-portrait.svg' %>"
                alt="<%= agent.name %>"
                width="64"
                height="80"
                loading="lazy"
                decoding="async"
                class="w-16 h-20 rounded-2xl object-cover border border-slate-200 shrink-0"
              >
              <div>
                <h2 class="font-serif font-bold text-xl text-slate-900"><%= agent.name %></h2>
                <p class="text-xs text-slate-600 mt-0.5"><%= agent.title %></p>
                <% if (agent.licenseNumber && agent.licenseNumber !== '-') { %>
                  <span class="inline-block mt-1 px-2.5 py-0.5 rounded bg-amber-50 text-amber-800 text-[11px] font-bold">
                    <%= agent.licenseNumber %>
                  </span>
                <% } %>
              </div>
            </div>

            <div class="space-y-3.5 text-sm">
              <% if (agent.phone) { %>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Telefon bezpośredni</span>
                  <a href="tel:<%= agent.phone.replace(/\s+/g, '') %>" class="text-xl font-bold text-slate-900 hover:text-amber-700 mt-0.5 block">
                    <%= agent.phone %>
                  </a>
                </div>
              <% } %>

              <% if (agent.email) { %>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Adres e-mail</span>
                  <a href="mailto:<%= agent.email %>" class="text-base font-semibold text-amber-700 hover:underline mt-0.5 block break-all">
                    <%= agent.email %>
                  </a>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>

        <% if (helpers.hasOfficeAddress(settings.contact) || settings.contact?.workingHours) { %>
          <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4 text-sm">
            <% if (helpers.hasOfficeAddress(settings.contact)) { %>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Biuro / Spotkania</span>
                <p class="text-slate-800 font-medium mt-0.5"><%= helpers.formatOfficeAddress(settings.contact) %></p>
              </div>
            <% } %>

            <% if (settings.contact?.workingHours) { %>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Godziny dostępności</span>
                <p class="text-slate-600 mt-0.5"><%= settings.contact.workingHours %></p>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- Mapa -->
        <% if (helpers.hasOfficeAddress(settings.contact) && settings.contact?.mapEmbedUrl) { %>
          <div class="bg-white rounded-3xl border border-slate-200 p-3 shadow-sm overflow-hidden">
            <iframe
              src="<%= settings.contact.mapEmbedUrl %>"
              title="Mapa lokalizacji biura"
              class="w-full h-64 rounded-2xl border-0"
              loading="lazy"
            ></iframe>
          </div>
        <% } %>
      </div>

      <!-- Prawa kolumna: Formularz kontaktowy -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl border border-slate-200 p-7 sm:p-10 shadow-sm">
          <h2 class="font-serif font-bold text-2xl text-slate-900 mb-2">Wyślij wiadomość lub umów bezpłatną wycenę</h2>
          <p class="text-sm text-slate-600 mb-6">Wypełnij krótki formularz – skontaktujemy się z Tobą telefonicznie lub mailowo.</p>

          <form action="/kontakt" method="POST" class="space-y-5">
            <input type="hidden" name="redirectUrl" value="/kontakt">
            <% if (prefilledProperty) { %>
              <input type="hidden" name="propertyTitle" value="<%= prefilledProperty %>">
            <% } %>

            <% if (contactAgents.length > 1) { %>
              <div>
                <label for="contact-agent" class="block text-xs font-semibold text-slate-700 mb-1.5">Wybierz doradcę, z którym chcesz się skontaktować</label>
                <select id="contact-agent" name="agentId" class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white focus:border-amber-600 outline-none text-sm font-medium">
                  <% contactAgents.forEach(agent => { %>
                    <option value="<%= agent.id %>"><%= agent.name %> – <%= agent.title %></option>
                  <% }) %>
                </select>
              </div>
            <% } else { %>
              <input type="hidden" name="agentId" value="<%= primaryAgent.id %>">
            <% } %>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1.5">Imię i nazwisko *</label>
                <input
                  id="contact-name"
                  type="text"
                  name="name"
                  required
                  placeholder="Jan Kowalski"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 outline-none text-sm"
                >
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-semibold text-slate-700 mb-1.5">Numer telefonu *</label>
                <input
                  id="contact-phone"
                  type="tel"
                  name="phone"
                  required
                  placeholder="+48 600 000 000"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 outline-none text-sm"
                >
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1.5">Adres e-mail</label>
                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  placeholder="jan@example.com"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 outline-none text-sm"
                >
              </div>
              <div>
                <label for="contact-subject" class="block text-xs font-semibold text-slate-700 mb-1.5">Temat rozmowy</label>
                <input
                  id="contact-subject"
                  type="text"
                  name="subject"
                  value="<%= prefilledSubject || 'Chcę sprzedać / wycenić nieruchomość' %>"
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 outline-none text-sm"
                >
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1.5">Treść wiadomości *</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Opisz krótko swoją nieruchomość lub czego poszukujesz..."
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-600 outline-none text-sm"
              ></textarea>
            </div>

            <label class="flex items-start gap-2.5 text-xs text-slate-600 leading-relaxed cursor-pointer">
              <input
                type="checkbox"
                name="privacyAccepted"
                value="1"
                required
                class="mt-0.5 w-4 h-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500 shrink-0"
              >
              <span>
                Zapoznałem(-am) się z <a href="/polityka-prywatnosci" target="_blank" class="font-semibold text-amber-700 hover:underline">Polityką Prywatności</a> i wyrażam zgodę na kontakt telefoniczny lub mailowy w celu obsługi przesłanego zapytania. *
              </span>
            </label>

            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-amber-600 text-white font-semibold text-sm shadow transition"
            >
              Wyślij wiadomość →
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
