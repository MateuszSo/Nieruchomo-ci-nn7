# Konfiguracja aplikacji (HitMe.pl / środowisko lokalne)
NODE_ENV=production
PORT=3000

# Kanoniczny adres domeny do Sitemap, Open Graph i SEO (np. https://nn7.pl - opcjonalnie, domyślnie wykrywany z nagłówka żądania)
SITE_URL=

# Klucz sesji (zmień na własny losowy ciąg znaków na produkcji)
SESSION_SECRET=super-tajny-klucz-sesji-agenta-nieruchomosci-2026

# Domyślne dane pierwszego logowania właściciela (można zmienić później w panelu /admin)
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASS=Admin123!

# Konfiguracja skrzynki pocztowej SMTP (np. MegaPoczta HitMe.pl)
# Jeśli puste, wiadomości zapisują się w panelu administratora bez wysyłki e-mail
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Biuro Nieruchomości <kontakt@twojadomena.pl>"
CONTACT_RECEIVER_EMAIL=
